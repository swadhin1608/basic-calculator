def addition(a,b):
    return a+b 

def subtraction(a,b):
    return a-b 

def multiplication(a,b):
    return a*b

def division(a,b):
    return a/b  

def percentage(a,b):
    return (a/b)*100


a = float(input("enter the first number ").strip())
b = float(input("enter the second number ").strip())
   
operation = input("what operation do you want to perform ? ").strip()

if operation == "addition": print(round(addition(a,b), 2))
elif operation == "subtraction": print(round(subtraction(a,b), 2))
elif operation == "multiplication": print(round(multiplication(a,b), 2))
elif operation == "division": print(round(division(a,b), 2))
elif operation == "percentage": print(round(percentage(a,b), 2))


                         